# Copie para .env. Este arquivo não contém segredos.
APP_ENVIRONMENT=development
APP_DATABASE_PATH=data/tasks.db
# Desenvolvimento/testes: ausente = escrita sem autenticação. Em produção, defina
# uma chave longa fora do Git e envie-a no cabeçalho X-API-Key.
# APP_API_KEY=troque-por-um-segredo-gerado
# GRAFANA_ADMIN_PASSWORD=troque-por-outro-segredo-gerado
